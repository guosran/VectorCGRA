        $var reg 35 ?F recv_xbar.msg $end
        $var reg 1 'G recv_fu.rdy $end
        $var reg 1 ?J recv_xbar.val $end
        $var reg 35 x) send.msg $end
        $var reg 1 \e send.rdy $end
        $var reg 1 . clk $end
      $upscope $end
    $upscope $end
    $scope module bypass_queue $end
      $var reg 1 "*4 recv.rdy $end
      $var reg 1 17 count $end
      $var reg 1 "*3 recv.val $end
      $var reg 1 "*8 send.rdy $end
      $var reg 1 : reset $end
      $var reg 1 "*7 send.val $end
      $var reg 202 "'C recv.msg $end
      $var reg 1 . clk $end
      $var reg 202 "'G send.msg $end
      $scope module q $end
        $var reg 1 "*7 send.val $end
        $var reg 1 . clk $end
        $var reg 1 "*4 recv.rdy $end
        $var reg 202 "'G send.msg $end
        $var reg 1 : reset $end
        $var reg 202 "'> entry $end
        $var reg 1 17 full $end
        $var reg 1 "*8 send.rdy $end
        $var reg 202 "'C recv.msg $end
        $var reg 1 17 count $end
        $var reg 1 "*3 recv.val $end
        $scope module bypass_mux $end
          $var reg 1 . clk $end
          $var reg 202 "'C in_(0) $end
          $var reg 1 17 sel $end
          $var reg 1 : reset $end
          $var reg 202 "'> in_(1) $end
          $var reg 202 "'G out $end
        $upscope $end
      $upscope $end
    $upscope $end
  $upscope $end
$upscope $end
$enddefinitions $end

